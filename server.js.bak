app.patch('/api/purchase-orders/:id/status', isAuthenticated, hasRole(['admin', 'finance']), async (req, res) => {
  const id = parseInt(req.params.id);
  const { status } = req.body;
  if (isNaN(id)) return res.status(400).json({ error: 'Invalid PO ID.' });
  if (!status) return res.status(400).json({ error: 'Status is required.' });
  try {
    const result = await pool.query(
      `UPDATE purchase_orders SET status = $1, delivered_at = CASE WHEN $1 = 'received' THEN NOW() ELSE delivered_at END
       WHERE po_id = $2 RETURNING *`, [status, id]
    );
    if (result.rows.length === 0) return res.status(404).json({ error: 'PO not found.' });
    res.json({ message: `PO status updated to ${status}.`, purchase_order: result.rows[0] });
  } catch (err) { res.status(500).json({ error: err.message }); }
});

app.patch('/api/purchase-orders/:id/receive', isAuthenticated, hasRole(['admin', 'technician']), async (req, res) => {
  const id = parseInt(req.params.id);
  if (isNaN(id)) return res.status(400).json({ error: 'Invalid PO ID.' });
  try {
    const poResult = await pool.query('SELECT * FROM purchase_orders WHERE po_id = $1', [id]);
    if (poResult.rows.length === 0) return res.status(404).json({ error: 'Purchase Order not found.' });
    const po = poResult.rows[0];
    if (po.status === 'received') return res.status(400).json({ error: 'Already received.' });
    const updateResult = await pool.query(
      `UPDATE purchase_orders SET status = 'received', received_at = NOW() WHERE po_id = $1 RETURNING *`, [id]
    );
    await pool.query(`UPDATE requests SET status = 'received' WHERE request_id = $1`, [po.request_id]);
    const reqInfo = await pool.query('SELECT part, serial, client, qty, inventory_id FROM requests WHERE request_id = $1', [po.request_id]);
    const r = reqInfo.rows[0] || {};
    await logAudit(req, {
      entityType: 'po', entityId: id,
      action: 'po.received',
      itemPart: r.part, itemSerial: r.serial, itemClient: r.client,
      inventoryId: r.inventory_id, requestId: po.request_id, qty: r.qty,
      fromStatus: po.status, toStatus: 'received',
      notes: `PO ${po.po_number} received`
    });
    res.json({ message: `PO ${po.po_number} received.`, purchase_order: updateResult.rows[0] });
  } catch (err) { res.status(500).json({ error: err.message }); }
});

